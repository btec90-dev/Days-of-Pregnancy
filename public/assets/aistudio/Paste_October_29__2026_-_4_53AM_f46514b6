    /**
     * Heartbeat Web Audio Synthesizer
     */
    let audioCtx = null;
    let heartbeatInterval = null;

    function toggleHeartbeatAudio() {
      if (STATE.audioPlaying) {
        if (heartbeatInterval) clearInterval(heartbeatInterval);
        STATE.audioPlaying = false;
        document.getElementById('heartbeat-text').textContent = "Écouter Cœur";
        return;
      }

      const AudioContext = window.AudioContext || window.webkitAudioContext;
      audioCtx = audioCtx || new AudioContext();
      if (audioCtx.state === 'suspended') audioCtx.resume();

      STATE.audioPlaying = true;
      document.getElementById('heartbeat-text').textContent = "Cœur Fœtal (145 BPM)";
      playLubDub(audioCtx);
      heartbeatInterval = setInterval(() => playLubDub(audioCtx), 413);
    }

    function playLubDub(ctx) {
      if (!ctx || ctx.state === 'suspended') return;
      playTone(ctx, 80, 0.12, 0.3);
      setTimeout(() => playTone(ctx, 110, 0.09, 0.25), 130);
    }

    function playTone(ctx, freq, duration, gainValue) {
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + duration);
        gain.gain.setValueAtTime(gainValue, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (err) {}
    }

