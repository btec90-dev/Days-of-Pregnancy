      if (sectionKey === 'baby' && STATE.customBagItems) items.push(...STATE.customBagItems);

      items.forEach(itemText => {
        const itemKey = `bag-${itemText}`;
        const isChecked = !!STATE.hospitalBag[itemKey];
        const row = document.createElement('label');
        row.className = "flex items-start gap-2 p-1 rounded-lg hover:bg-white/70 cursor-pointer transition";
