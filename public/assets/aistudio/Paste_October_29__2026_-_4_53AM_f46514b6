      document.getElementById('slider-week-display').textContent = `Semaine ${weekNum}`;

      document.getElementById('detail-card-title').textContent = `Semaine ${weekNum} : ${data.titleFr}`;
      document.getElementById('detail-card-fruit').innerHTML = `Taille comparable : <strong>${data.fruit}</strong> ~ ${data.length} • ${data.weight}`;
      document.getElementById('detail-card-fhr').textContent = data.fhr || "~140-160 BPM";
      document.getElementById('detail-card-trimester').textContent = weekNum >= 27 ? "3e Trimestre" : weekNum >= 13 ? "2e Trimestre" : "1er Trimestre";
      document.getElementById('detail-card-mom-notes').textContent = data.momSummaryFr;
      document.getElementById('sync-week-num').textContent = weekNum;
      document.getElementById('detail-card-highlights').innerHTML = `<li>${data.fetalSummaryFr}</li><li>${data.clinical}</li>`;
    }

    /**
     * Tabs & Global Listeners
     */
    function initTabs() {
      document.querySelectorAll('.nav-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.nav-tab').forEach(t => {
            t.classList.remove('active', 'bg-wood-800', 'text-amber-50', 'shadow-inner');
            t.classList.add('text-wood-800');
          });
          tab.classList.add('active', 'bg-wood-800', 'text-amber-50', 'shadow-inner');
          tab.classList.remove('text-wood-800');

          const targetId = tab.dataset.target;
          document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
          document.getElementById(targetId).classList.remove('hidden');

          if (targetId === 'tab-3d') setTimeout(onWindowResize, 50);
        });
      });
    }

