        document.getElementById('label-womb-transp').textContent = isWombSemiTransparent ? "Utérus Semi-Transparent" : "Utérus Opaque";
      });

      document.getElementById('btn-reset-cam').addEventListener('click', () => {
        if (controls && camera) {
          controls.reset();
          camera.position.set(0, 0.5, 5.5);
        }
      });

      document.getElementById('btn-toggle-heartbeat').addEventListener('click', toggleHeartbeatAudio);

      // Settings Modal
      const settingsModal = document.getElementById('settings-modal');
