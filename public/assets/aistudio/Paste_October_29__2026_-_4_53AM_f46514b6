    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <!-- Mother & Baby Header Info -->
        <div class="flex items-start gap-3.5">
          <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-amber-100 to-amber-300 border-2 border-brass flex items-center justify-center shadow-md flex-shrink-0 relative overflow-hidden">
            <span class="font-serif text-2xl font-bold text-wood-800">F</span>
            <div class="absolute -bottom-1 -right-1 text-brass-dark opacity-60">
              <i data-lucide="sparkles" class="w-4 h-4"></i>
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-xl sm:text-2xl font-serif font-bold text-wood-900 tracking-tight" id="header-patient-title">
                Fatou’s Pregnancy Journey
              </h1>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-300">
                <i data-lucide="check-check" class="w-3 h-3"></i> RMA NY • FET
              </span>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                👦 Garçon (Male Euploid)
              </span>
            </div>
            <p class="text-xs text-wood-700 flex flex-wrap items-center gap-x-3 gap-y-1 mt-0.5">
              <span><i data-lucide="user-check" class="w-3.5 h-3.5 inline text-wood-600 mr-1"></i>Dr. Anate Brauer (RMA of New York)</span>
              <span>•</span>
              <span><i data-lucide="calendar" class="w-3.5 h-3.5 inline text-amber-700 mr-1"></i>Transfert FET : <strong id="header-fet-date">03 Nov. 2026</strong></span>
            </p>
          </div>
        </div>

        <!-- Calculated Live Badges -->
        <div class="flex flex-wrap items-center gap-2 bg-white/75 backdrop-blur-md p-2 rounded-2xl border border-wood-300 shadow-sm">
          <div class="px-3 py-1 rounded-xl bg-wood-50 border border-wood-200">
            <div class="text-[10px] uppercase font-bold tracking-wider text-wood-600" id="label-ga">Âge Gestationnel</div>
            <div class="text-sm sm:text-base font-bold text-wood-900" id="current-ga-badge">Semaine 2 + 5j</div>
          </div>

          <div class="px-3 py-1 rounded-xl bg-amber-50 border border-amber-200">
            <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700" id="label-edd">Terme Prévu (DPA)</div>
            <div class="text-sm sm:text-base font-bold text-amber-950" id="current-edd-badge">27 Juil. 2027</div>
          </div>

          <div class="px-3 py-1 rounded-xl bg-emerald-50 border border-emerald-200">
            <div class="text-[10px] uppercase font-bold tracking-wider text-emerald-700" id="label-countdown">Décompte</div>
            <div class="text-sm sm:text-base font-bold text-emerald-950" id="current-countdown-badge">~261 Jours</div>
          </div>

          <button id="btn-open-settings" class="px-3 py-2 rounded-xl bg-wood-600 hover:bg-wood-700 text-white font-medium text-xs flex items-center gap-1.5 transition shadow-sm" title="Paramètres">
            <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
            <span class="hidden sm:inline">Paramètres</span>
          </button>
        </div>

      </div>

      <!-- Trimester & Heartbeat Mini-bar -->
      <div class="mt-3 pt-2.5 border-t border-wood-300/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs">
        <div class="flex items-center gap-3 w-full sm:w-2/3">
          <span class="font-semibold text-wood-800 whitespace-nowrap text-xs" id="trimester-indicator">1er Trimestre • Phase Embryonnaire</span>
          <div class="w-full bg-wood-200/90 h-2.5 rounded-full overflow-hidden p-0.5 border border-wood-300 shadow-inner">
            <div id="progress-bar-fill" class="h-full rounded-full bg-gradient-to-r from-sage-400 via-peach-400 to-honey-400 transition-all duration-700" style="width: 7%;"></div>
          </div>
          <span class="text-wood-700 font-bold text-xs" id="progress-percent-label">7%</span>
        </div>

        <div class="flex items-center gap-2 self-end sm:self-auto">
          <button id="btn-toggle-heartbeat" class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100 transition font-medium text-xs">
            <i data-lucide="activity" class="w-3.5 h-3.5 animate-heartbeat text-rose-600"></i>
            <span id="heartbeat-text">Cœur Fœtal (145 BPM)</span>
          </button>
          
          <button id="btn-toggle-lang" class="px-2.5 py-1 rounded-full bg-wood-100 border border-wood-300 text-wood-800 hover:bg-wood-200 transition font-bold text-xs">
            FR / EN
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- NAVIGATION TABS -->
  <nav class="bg-[#DFCEB3] border-b border-wood-300 sticky top-0 z-30 shadow-sm backdrop-blur-md bg-opacity-95">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between overflow-x-auto no-scrollbar py-1.5">
      <div class="flex items-center space-x-1.5 sm:space-x-3">
        <button class="nav-tab active px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 bg-wood-800 text-amber-50 shadow-inner" data-target="tab-windows">
          <i data-lucide="layout-grid" class="w-4 h-4"></i>
          <span id="nav-board">Tableau 40 Semaines</span>
        </button>
        <button class="nav-tab px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 text-wood-800 hover:bg-wood-200 transition" data-target="tab-3d">
          <i data-lucide="box" class="w-4 h-4"></i>
          <span id="nav-3d">Fœtus 3D Utérin</span>
        </button>
        <button class="nav-tab px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 text-wood-800 hover:bg-wood-200 transition" data-target="tab-rma">
          <i data-lucide="stethoscope" class="w-4 h-4 text-emerald-800"></i>
          <span id="nav-rma">Protocole RMA & OB</span>
        </button>
        <button class="nav-tab px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 text-wood-800 hover:bg-wood-200 transition" data-target="tab-journal">
          <i data-lucide="book-heart" class="w-4 h-4 text-rose-700"></i>
          <span id="nav-journal">Journal & Mouvements</span>
        </button>
        <button class="nav-tab px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 text-wood-800 hover:bg-wood-200 transition" data-target="tab-meds">
          <i data-lucide="pill" class="w-4 h-4 text-purple-700"></i>
          <span id="nav-meds">Traitements FIV & Poids</span>
        </button>
        <button class="nav-tab px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 text-wood-800 hover:bg-wood-200 transition" data-target="tab-tools">
          <i data-lucide="briefcase-medical" class="w-4 h-4 text-amber-800"></i>
          <span id="nav-tools">Valise & Plan de Naissance</span>
        </button>
        <button class="nav-tab px-3.5 py-2 rounded-xl font-medium text-xs sm:text-sm flex items-center gap-1.5 text-wood-800 hover:bg-wood-200 transition" data-target="tab-guide">
          <i data-lucide="compass" class="w-4 h-4 text-amber-900"></i>
          <span id="nav-guide">Guide & Conseils</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
    
    <!-- ==================== TAB 1: THE WOODEN WINDOW BOARD ==================== -->
    <section id="tab-windows" class="tab-pane active space-y-5">
      <div class="wood-grain p-5 rounded-3xl border-4 border-wood-300 shadow-wooden-panel relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="absolute top-2.5 left-2.5 brass-stud"></div>
        <div class="absolute top-2.5 right-2.5 brass-stud"></div>
        <div class="absolute bottom-2.5 left-2.5 brass-stud"></div>
        <div class="absolute bottom-2.5 right-2.5 brass-stud"></div>

        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-wood-900 tracking-tight flex items-center gap-2">
            <span>Le Calendrier Mural des 40 Semaines</span>
            <span class="text-xs px-2 py-0.5 rounded-md bg-amber-100 text-amber-900 border border-amber-300 font-sans">Interactif</span>
          </h2>
          <p class="text-xs sm:text-sm text-wood-700 mt-1 max-w-2xl" id="board-instruction">
            Cliquez sur un volet en bois pour l'ouvrir : découvrez la taille du bébé comparée à un fruit, la vidéo médicale 3D avec minutage précis, les dates exactes du protocole RMA et vos check-lists.
          </p>
        </div>

        <div class="flex items-center gap-2 bg-white/80 p-2 rounded-2xl border border-wood-300">
          <label class="text-xs font-semibold text-wood-800">Semaine :</label>
          <select id="select-week-jump" class="text-xs font-medium bg-wood-50 border border-wood-300 rounded-lg px-2.5 py-1.5 text-wood-900 focus:outline-none focus:ring-2 focus:ring-amber-500">
          </select>
          <button id="btn-jump-current" class="px-2.5 py-1.5 bg-wood-700 hover:bg-wood-800 text-white rounded-lg text-xs font-semibold shadow transition">
            Aujourd'hui
          </button>
        </div>
      </div>

      <!-- Wooden Board 40-grid -->
      <div class="wood-grain p-4 sm:p-7 rounded-[2.5rem] border-8 border-wood-400 shadow-2xl relative">
        <div class="absolute inset-2 border border-wood-300/70 rounded-[2.2rem] pointer-events-none"></div>
        <div id="windows-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-8 gap-3 sm:gap-4 relative z-10">
        </div>
      </div>
    </section>

    <!-- ==================== TAB 2: PROCEDURAL 3D BABY IN WOMB ==================== -->
    <section id="tab-3d" class="tab-pane hidden space-y-5">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- 3D Canvas Box -->
        <div class="lg:col-span-8 bg-gradient-to-b from-stone-900 via-stone-950 to-amber-950 rounded-3xl p-4 shadow-2xl border-4 border-wood-400 relative overflow-hidden flex flex-col">
          
          <div class="absolute top-6 left-6 z-10 glass-morphism px-4 py-2.5 rounded-2xl border border-white/20 text-stone-900 shadow-lg max-w-xs">
            <div class="text-[10px] uppercase font-bold text-amber-800 tracking-wider">Modélisation Fœtale 3D</div>
            <div class="text-lg font-serif font-bold text-stone-900" id="three-week-title">Semaine 12 • Fœtus Formé</div>
