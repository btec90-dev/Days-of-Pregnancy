    /**
     * Kick Counter Session Engine
     */
    let kickSessionRunning = false;
    let kickSessionStartTime = null;
    let kickSessionTimerInterval = null;
    let currentKickCount = 0;

    function initKickSession() {
      const btnStart = document.getElementById('btn-start-kick-session');
      const btnPlus = document.getElementById('btn-kick-plus');
      const btnMinus = document.getElementById('btn-kick-minus');
      const display = document.getElementById('kick-count-display');
      const timerDisplay = document.getElementById('kick-session-timer');

      btnStart.addEventListener('click', () => {
        if (!kickSessionRunning) {
          kickSessionRunning = true;
          kickSessionStartTime = Date.now();
          currentKickCount = 0;
          display.textContent = `0 / 10`;
          btnStart.innerHTML = `<i data-lucide="square" class="w-3 h-3"></i> Arrêter`;
          lucide.createIcons();

          kickSessionTimerInterval = setInterval(() => {
            const diffSec = Math.floor((Date.now() - kickSessionStartTime) / 1000);
            const m = Math.floor(diffSec / 60).toString().padStart(2, '0');
            const s = (diffSec % 60).toString().padStart(2, '0');
            timerDisplay.textContent = `${m}:${s}`;
          }, 500);
        } else {
          stopKickSession();
        }
      });

      btnPlus.addEventListener('click', () => {
        currentKickCount++;
        display.textContent = `${currentKickCount} / 10`;
        if (currentKickCount >= 10 && kickSessionRunning) {
          confetti({ particleCount: 40, spread: 60, origin: { y: 0.6 } });
          stopKickSession(true);
        }
      });

      btnMinus.addEventListener('click', () => {
        currentKickCount = Math.max(0, currentKickCount - 1);
        display.textContent = `${currentKickCount} / 10`;
      });
    }

    function stopKickSession(completed = false) {
      kickSessionRunning = false;
      clearInterval(kickSessionTimerInterval);
      const btnStart = document.getElementById('btn-start-kick-session');
      btnStart.innerHTML = `<i data-lucide="play" class="w-3 h-3"></i> Démarrer Séance`;
      lucide.createIcons();

      if (completed) {
        const diffSec = Math.floor((Date.now() - kickSessionStartTime) / 1000);
        const m = Math.floor(diffSec / 60);
        const s = diffSec % 60;
        alert(`Félicitations Fatou ! 10 mouvements enregistrés en ${m}m ${s}s.`);
      }
    }

