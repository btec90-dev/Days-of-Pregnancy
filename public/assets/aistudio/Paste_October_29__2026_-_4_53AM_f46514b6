  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            serif: ['"Playfair Display"', 'serif'],
            title: ['"Cinzel"', 'serif'],
          },
          colors: {
            wood: {
              50: '#FDFBF7',
              100: '#F6EEDB',
              200: '#EBD8B8',
              300: '#DFC295',
              400: '#CCA371',
              500: '#B58752',
              600: '#946B3C',
              700: '#73512B',
              800: '#523A20',
              900: '#342413',
            },
            sage: {
              50: '#F2F7F4',
              100: '#DFECE4',
              200: '#C2D9CB',
              300: '#9EBEAC',
              400: '#7DA48E',
              500: '#5F8771',
              600: '#4A6C58',
            },
            peach: {
              50: '#FFF7F2',
              100: '#FFEBDC',
              200: '#FFD3B5',
              300: '#FBB98B',
              400: '#F59A61',
              500: '#E37837',
            },
            honey: {
              50: '#FFFDF0',
              100: '#FEF8C8',
              200: '#FCEF90',
              300: '#F8DF56',
              400: '#EABF23',
              500: '#C79A10',
            },
            brass: {
              light: '#E6CA85',
              DEFAULT: '#C5A059',
              dark: '#9B7836',
            }
          },
          boxShadow: {
            'wood-emboss': 'inset 1px 1px 2px rgba(255,255,255,0.7), inset -1px -1px 3px rgba(0,0,0,0.15), 0 10px 25px -5px rgba(60, 40, 20, 0.15)',
            'wooden-panel': 'inset 0 2px 4px rgba(255,255,255,0.5), inset 0 -3px 6px rgba(0,0,0,0.2), 0 14px 28px rgba(0,0,0,0.12), 0 10px 10px rgba(0,0,0,0.08)',
          }
        }
      }
    }
  </script>

  <style>
    .wood-grain {
      background-color: #EEDCC4;
      background-image: 
        radial-gradient(ellipse at 50% 20%, rgba(255,255,255,0.35) 0%, rgba(0,0,0,0.05) 100%),
        repeating-linear-gradient(90deg, rgba(160,110,60,0.03) 0px, rgba(160,110,60,0.03) 1px, transparent 1px, transparent 8px),
        repeating-linear-gradient(0deg, rgba(120,70,30,0.02) 0px, rgba(120,70,30,0.02) 2px, transparent 2px, transparent 24px);
    }
    .window-card {
      perspective: 1200px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .window-card:hover {
      transform: translateY(-4px);
    }
    .brass-stud {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #fff1ba, #c5a059 60%, #7d5e23 100%);
      box-shadow: 0 1px 2px rgba(0,0,0,0.35);
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(220, 190, 150, 0.2);
    }
    ::-webkit-scrollbar-thumb {
      background: #CCA371;
      border-radius: 4px;
    }
    @keyframes heartbeat {
      0% { transform: scale(1); }
      14% { transform: scale(1.16); }
      28% { transform: scale(1); }
      42% { transform: scale(1.12); }
      70% { transform: scale(1); }
    }
    .animate-heartbeat {
      animation: heartbeat 1.1s infinite cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .glass-morphism {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }
  </style>
</head>
<body class="bg-[#F6EEDB] text-stone-800 antialiased min-h-full flex flex-col font-sans selection:bg-amber-200">

  <!-- TOP HEADER / CLINICAL PROTOCOL BAR -->
