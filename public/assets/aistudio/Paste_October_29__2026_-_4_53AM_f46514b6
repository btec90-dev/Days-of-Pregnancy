            </button>
            <button id="btn-toggle-womb-transparency" class="glass-morphism px-3 py-2 rounded-xl text-stone-800 hover:bg-white text-xs font-semibold flex items-center gap-1 shadow">
              <i data-lucide="eye" class="w-4 h-4"></i>
              <span id="label-womb-transp">Utérus Semi-Transparent</span>
            </button>
          </div>

          <div class="w-full h-[520px] rounded-2xl overflow-hidden relative cursor-grab active:cursor-grabbing" id="womb-canvas-container">
          </div>

          <div class="mt-4 bg-stone-800/80 backdrop-blur-md rounded-2xl p-4 border border-stone-700/80 text-white flex flex-col gap-2">
            <div class="flex items-center justify-between text-xs font-medium">
              <span class="text-amber-300 font-bold flex items-center gap-1.5">
                <i data-lucide="play" class="w-3.5 h-3.5 fill-amber-300"></i>
