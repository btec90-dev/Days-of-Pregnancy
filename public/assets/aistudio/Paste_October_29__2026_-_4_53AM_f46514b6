      document.getElementById('three-week-slider').addEventListener('input', (e) => {
        const w = parseInt(e.target.value);
        if (!isNaN(w)) update3DWeek(w);
      });

      document.getElementById('modal-btn-view3d').addEventListener('click', () => {
        closeModal();
        document.querySelector('[data-target="tab-3d"]').click();
