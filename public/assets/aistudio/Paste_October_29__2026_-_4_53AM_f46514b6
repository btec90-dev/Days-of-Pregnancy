    function computeMetrics() {
      const fetDate = new Date(STATE.fetDateString + "T00:00:00");
      const today = new Date();
      const lmpEquivalent = new Date(fetDate.getTime() - (14 + STATE.embryoAgeDays) * 24 * 60 * 60 * 1000);
      const edd = new Date(lmpEquivalent.getTime() + 280 * 24 * 60 * 60 * 1000);

      const diffMs = today.getTime() - lmpEquivalent.getTime();
      const diffDays = Math.floor(diffMs / (24 * 60 * 60 * 1000));

      let currentGAWeeks = Math.floor(diffDays / 7);
      let currentGADays = diffDays % 7;
      if (diffDays < 0) { currentGAWeeks = 0; currentGADays = 0; }

      const daysUntilEDD = Math.max(0, Math.ceil((edd.getTime() - today.getTime()) / (24 * 60 * 60 * 1000)));

      let trimester = 1;
      let trimesterLabel = "1er Trimestre (T1)";
      if (currentGAWeeks >= 28) {
        trimester = 3;
        trimesterLabel = "3e Trimestre (T3)";
      } else if (currentGAWeeks >= 13) {
        trimester = 2;
        trimesterLabel = "2e Trimestre (T2)";
      }

      const clampedDays = Math.max(0, Math.min(280, diffDays));
      const percent = Math.min(100, Math.round((clampedDays / 280) * 100));

      return { fetDate, lmpEquivalent, edd, diffDays, currentGAWeeks, currentGADays, daysUntilEDD, trimester, trimesterLabel, percent };
    }

    function getWeekDateRange(weekNum) {
      const { lmpEquivalent } = computeMetrics();
      const startMs = lmpEquivalent.getTime() + (weekNum - 1) * 7 * 24 * 60 * 60 * 1000;
      const endMs = startMs + 6 * 24 * 60 * 60 * 1000;
      const startDate = new Date(startMs);
      const endDate = new Date(endMs);
      const options = { month: 'short', day: 'numeric', year: 'numeric' };
      const optionsNoYear = { month: 'short', day: 'numeric' };
      return `${startDate.toLocaleDateString(STATE.currentLang === 'fr' ? 'fr-FR' : 'en-US', optionsNoYear)} — ${endDate.toLocaleDateString(STATE.currentLang === 'fr' ? 'fr-FR' : 'en-US', options)}`;
    }

