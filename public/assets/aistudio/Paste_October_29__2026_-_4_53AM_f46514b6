    /**
     * Contraction Stopwatch
     */
    let timerRunning = false;
    let timerStartTime = null;
    let timerInterval = null;

    function initContractionTimer() {
      const btn = document.getElementById('btn-toggle-contraction');
      btn.addEventListener('click', () => {
        if (!timerRunning) {
          timerRunning = true;
          timerStartTime = Date.now();
          document.getElementById('contraction-btn-text').textContent = "Arrêter Contraction";
          document.getElementById('timer-status-text').textContent = "Contraction en cours...";
          btn.classList.replace('bg-rose-600', 'bg-stone-800');

          timerInterval = setInterval(() => {
            const diff = Math.floor((Date.now() - timerStartTime) / 1000);
            const m = Math.floor(diff / 60).toString().padStart(2, '0');
            const s = (diff % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').textContent = `${m}:${s}`;
          }, 500);
        } else {
          timerRunning = false;
          clearInterval(timerInterval);
          const dur = Math.max(1, Math.floor((Date.now() - timerStartTime) / 1000));
          const prev = STATE.contractionsHistory[0];
          let intervalMin = "--";
          if (prev) intervalMin = Math.round((timerStartTime - prev.timestamp) / (60000)) + " min";

          STATE.contractionsHistory.unshift({
            timestamp: timerStartTime,
            timeFormatted: new Date(timerStartTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            durationSec: dur,
            intervalMin: intervalMin
          });
          saveState();
          renderContractionsLog();

          document.getElementById('timer-display').textContent = "00:00";
          document.getElementById('contraction-btn-text').textContent = "Démarrer Contraction";
          document.getElementById('timer-status-text').textContent = "Contraction enregistrée";
          btn.classList.replace('bg-stone-800', 'bg-rose-600');
        }
      });

      document.getElementById('btn-reset-contractions').addEventListener('click', () => {
        STATE.contractionsHistory = [];
        saveState();
        renderContractionsLog();
      });

      renderContractionsLog();
    }

    function renderContractionsLog() {
      const container = document.getElementById('contractions-list');
      const countEl = document.getElementById('contractions-count');
      const hist = STATE.contractionsHistory;
      countEl.textContent = `${hist.length} enregistrée(s)`;

      if (hist.length === 0) {
        container.innerHTML = `<p class="text-stone-400 text-center py-3 text-[11px]">Aucune contraction enregistrée.</p>`;
        return;
      }

      container.innerHTML = hist.slice(0, 8).map((c, i) => `
        <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-wood-200">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-full bg-rose-100 text-rose-800 text-[10px] font-bold flex items-center justify-center">${hist.length - i}</span>
            <span class="font-bold text-wood-900">${c.timeFormatted}</span>
          </div>
          <div>
            <span class="font-bold text-rose-700">${c.durationSec}s</span>
            <span class="text-[10px] text-wood-500 ml-1.5">(espacées de ${c.intervalMin})</span>
          </div>
        </div>
      `).join('');
    }

    /**
     * Procedural 3D Womb (Three.js)
     */
    let scene, camera, renderer, controls, wombMesh, fetusGroup;
    let isWombSemiTransparent = true;

    function initThreeJS() {
      const container = document.getElementById('womb-canvas-container');
      const width = container.clientWidth || 600;
      const height = container.clientHeight || 520;

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0e0a08);
      scene.fog = new THREE.FogExp2(0x0e0a08, 0.08);

      camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 50);
      camera.position.set(0, 0.5, 5.5);

      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      if (typeof THREE.OrbitControls !== 'undefined') {
        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
      }

      scene.add(new THREE.AmbientLight(0xffeedd, 0.8));
      const mainLight = new THREE.DirectionalLight(0xffb592, 1.8);
      mainLight.position.set(4, 5, 4);
      scene.add(mainLight);

      const rimLight = new THREE.PointLight(0xf59e0b, 2.2, 15);
      rimLight.position.set(-3, -2, -2);
      scene.add(rimLight);

      // Womb
      const wombGeo = new THREE.SphereGeometry(2.1, 48, 36);
      wombGeo.scale(1, 1.25, 0.95);
      const wombMat = new THREE.MeshPhysicalMaterial({
        color: 0x99222a,
        emissive: 0x33080c,
        roughness: 0.25,
        transmission: 0.6,
        opacity: 0.45,
        transparent: true,
        side: THREE.DoubleSide
      });
      wombMesh = new THREE.Mesh(wombGeo, wombMat);
      scene.add(wombMesh);

      fetusGroup = new THREE.Group();
      scene.add(fetusGroup);

      buildFetusMesh(12);
      window.addEventListener('resize', onWindowResize);
      animateThree();
    }

    function onWindowResize() {
      const container = document.getElementById('womb-canvas-container');
      if (!container || !renderer || !camera) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (w === 0 || h === 0) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }

    function animateThree() {
      requestAnimationFrame(animateThree);
      if (controls) controls.update();
      if (fetusGroup) fetusGroup.rotation.y += 0.003;
      if (renderer && scene && camera) renderer.render(scene, camera);
    }

    function buildFetusMesh(weekNum) {
      if (!fetusGroup) return;
      while (fetusGroup.children.length > 0) {
        const c = fetusGroup.children[0];
        if (c.geometry) c.geometry.dispose();
        if (c.material) {
          if (Array.isArray(c.material)) c.material.forEach(m => m.dispose());
          else c.material.dispose();
        }
        fetusGroup.remove(c);
      }

      const mat = new THREE.MeshStandardMaterial({ color: 0xf5b597, roughness: 0.4 });
      const scale = Math.min(1.6, 0.2 + (weekNum / 40) * 1.3);

      if (weekNum <= 4) {
        fetusGroup.add(new THREE.Mesh(new THREE.DodecahedronGeometry(0.25 * scale, 1), mat));
      } else {
        const head = new THREE.Mesh(new THREE.SphereGeometry(0.48 * scale, 32, 24), mat);
        head.position.set(0, 0.45 * scale, 0);
        fetusGroup.add(head);

        const body = new THREE.Mesh(new THREE.CylinderGeometry(0.35 * scale, 0.2 * scale, 0.7 * scale, 24), mat);
        body.position.set(0, -0.1 * scale, 0);
        body.rotation.z = 0.2;
        fetusGroup.add(body);

        const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.12 * scale, 0.12 * scale, 0.4 * scale, 16), mat);
        leg.position.set(0.2 * scale, -0.45 * scale, 0.1 * scale);
        leg.rotation.z = Math.PI / 3;
        fetusGroup.add(leg);

        const cordCurve = new THREE.CatmullRomCurve3([
          new THREE.Vector3(0, -0.1 * scale, 0.2 * scale),
          new THREE.Vector3(0.5, -0.3, 0.6),
          new THREE.Vector3(1.2, -0.6, 1.2)
        ]);
        fetusGroup.add(new THREE.Mesh(new THREE.TubeGeometry(cordCurve, 20, 0.05, 8, false), new THREE.MeshStandardMaterial({ color: 0x5ea396, roughness: 0.3 })));
      }
    }

    function update3DWeek(weekNum) {
      buildFetusMesh(weekNum);
      const data = WEEKS_DATA.find(d => d.week === weekNum) || WEEKS_DATA[11];

      document.getElementById('three-week-title').textContent = `Semaine ${weekNum} • ${data.titleFr}`;
      document.getElementById('three-week-sub').textContent = `Taille : ${data.fruit} (${data.length} • ${data.weight})`;
