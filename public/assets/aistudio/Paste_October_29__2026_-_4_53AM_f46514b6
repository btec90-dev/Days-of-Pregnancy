              <span id="slider-week-display" class="bg-amber-500/20 px-3 py-0.5 rounded-full text-amber-300 font-bold">Semaine 12</span>
            </div>
            <input type="range" id="three-week-slider" min="1" max="40" value="12" class="w-full h-2 bg-stone-700 rounded-lg appearance-none cursor-pointer accent-amber-400">
            <div class="flex justify-between text-[10px] text-stone-400 px-1">
              <span>Sem. 1 (Blastocyste)</span>
              <span>Sem. 12 (Organogenèse)</span>
              <span>Sem. 24 (Viabilité)</span>
              <span>Sem. 40 (Naissance)</span>
            </div>
          </div>
        </div>

        <!-- 3D Sidebar Info -->
        <div class="lg:col-span-4 space-y-4">
          <div class="wood-grain p-5 rounded-3xl border-2 border-wood-300 shadow-md space-y-4">
            <div class="flex items-center justify-between border-b border-wood-200 pb-2.5">
              <span class="text-xs uppercase font-bold tracking-wider text-wood-600">Détails Anatomiques</span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800" id="detail-card-trimester">1er Trimestre</span>
            </div>

            <div>
              <h3 class="text-lg font-serif font-bold text-wood-900" id="detail-card-title">Semaine 12 : Les Réflexes Débutent</h3>
              <p class="text-xs text-wood-700 mt-1" id="detail-card-fruit">Taille comparable : <strong>Prune (Plum)</strong> ~ 5.4 cm • 14 g</p>
            </div>

            <div class="bg-rose-50 border border-rose-200 rounded-2xl p-3 flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-rose-200 flex items-center justify-center text-rose-700 flex-shrink-0 animate-heartbeat">
                <i data-lucide="heart" class="w-5 h-5 fill-rose-500"></i>
              </div>
              <div>
                <div class="text-[10px] uppercase font-bold text-rose-700">Rythme Cardiaque Fœtal</div>
                <div class="text-sm font-bold text-rose-950" id="detail-card-fhr">~150 - 165 BPM</div>
                <div class="text-[11px] text-rose-600">Double du rythme maternel</div>
              </div>
            </div>

            <div class="space-y-1.5">
              <h4 class="text-xs font-bold text-wood-800 uppercase tracking-wide">Développements Clés :</h4>
              <ul class="text-xs text-wood-700 space-y-1 list-disc pl-4" id="detail-card-highlights">
                <li>Tous les organes vitaux et membres sont désormais formés.</li>
                <li>Le visage fœtal commence à prendre des expressions et les ongles se dessinent.</li>
                <li>Période idéale pour le DPNI et la clarté nucale.</li>
              </ul>
            </div>

            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3">
              <div class="text-[10px] uppercase font-bold text-amber-800">Chez la Maman (Fatou) :</div>
              <p class="text-xs text-amber-950 mt-1" id="detail-card-mom-notes">
                L'utérus remonte au-dessus de la symphyse pubienne, soulageant la pression vésicale.
              </p>
            </div>

            <button id="btn-sync-to-board" class="w-full py-2.5 bg-wood-800 hover:bg-wood-900 text-amber-50 rounded-xl font-medium text-xs shadow transition flex items-center justify-center gap-2">
              <i data-lucide="folder-open" class="w-4 h-4"></i>
              <span>Ouvrir le Volet Mural Semaine <span id="sync-week-num">12</span></span>
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== TAB 3: RMA PROTOCOL & OB TIMELINE ==================== -->
    <section id="tab-rma" class="tab-pane hidden space-y-6">
      <div class="wood-grain p-6 rounded-3xl border-4 border-wood-300 shadow-wooden-panel relative">
        <div class="max-w-3xl">
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
            Protocole RMA of New York • Dr. Anate Brauer
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-wood-900 mt-2">
            Feuille de Route Médicale : FET & Suivi Obstétrical
          </h2>
          <p class="text-xs sm:text-sm text-wood-700 mt-2">
            Chronologie médicale calculée pour votre transfert d'embryon congelé (FET) de début novembre 2026.
          </p>
        </div>

        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-wood-200">
          <div class="bg-white/70 p-3 rounded-2xl border border-wood-200">
            <span class="text-[10px] uppercase font-bold text-wood-500">Patiente & Dossier</span>
            <div class="text-sm font-bold text-wood-900">Fatou • FET J5 Euploïde</div>
            <div class="text-xs text-wood-600">Sélection confirmée : Garçon 👦</div>
          </div>
          <div class="bg-white/70 p-3 rounded-2xl border border-wood-200">
            <span class="text-[10px] uppercase font-bold text-wood-500">Clinique Initiale</span>
            <div class="text-sm font-bold text-wood-900">RMA of New York</div>
            <div class="text-xs text-wood-600">East Side • Manhattan, NY</div>
          </div>
          <div class="bg-white/70 p-3 rounded-2xl border border-wood-200">
            <span class="text-[10px] uppercase font-bold text-wood-500">Statut Suivi</span>
            <div class="text-sm font-bold text-emerald-700 flex items-center gap-1">
