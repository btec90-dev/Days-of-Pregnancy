      new THREE.Vector3(-0.1, -0.2, 0.9),
      new THREE.Vector3(-0.6, -0.7, 1.4),
      new THREE.Vector3(-1.4, -0.3, 1.8),
      new THREE.Vector3(-2.2, -1.2, 2.2)
    ]);
    const cordGeo = new THREE.TubeGeometry(curve, 20, 0.12, 8, false);
