  // MOTEUR AUDIO ROBUSTE : NARRATION VOCALE MASCULINE FRANÇAISE & TRANSCRIPTION KARAOKÉ
  // Formulation directe sans intro 'Bienvenue/Fatou/RMA', ton calme et posé
  // =========================================================================
  let isSpeaking = false;
  let frenchVoice = null;
  let availableVoices = [];
  let karaokeInterval = null;
  let currentWordList = [];
  let dopplerAudioCtx = null;
  let dopplerInterval = null;
  let isDopplerPlaying = false;
  let fallbackSynthTimer = null;

  function loadAndSelectFrenchVoice() {
    if (!('speechSynthesis' in window)) return null;
    try {
      availableVoices = window.speechSynthesis.getVoices() || [];
      if (availableVoices.length > 0) {
        const frVoices = availableVoices.filter(v => v.lang && (v.lang.toLowerCase() === 'fr-fr' || v.lang.toLowerCase() === 'fr_fr' || v.lang.toLowerCase().startsWith('fr')));

        // Priorité stricte à une voix masculine française humaine réaliste
        // Noms masculins fréquents: Thomas, Nicolas, Paul, Antoine, Henri, Mathieu, Claude, Bernard, Guy, Google français
        const maleKeywords = /thomas|nicolas|paul|antoine|henri|mathieu|claude|bernard|guy|male|homme|google\s*français/i;
        const femaleKeywords = /hortense|julie|celine|céline|audrey|amelie|amélie|denise|virginie|charlotte|marie|female|femme/i;

        const maleVoiceCandidates = frVoices.filter(v => maleKeywords.test(v.name) && !femaleKeywords.test(v.name));
        const nonFemaleVoices = frVoices.filter(v => !femaleKeywords.test(v.name));

        frenchVoice = maleVoiceCandidates[0] ||
                      nonFemaleVoices.find(v => v.lang.toLowerCase() === 'fr-fr') ||
                      frVoices.find(v => v.lang.toLowerCase() === 'fr-fr') ||
                      frVoices[0] ||
                      null;

        const voiceTag = document.getElementById('audio-lang-indicator');
        if (voiceTag) {
          if (frenchVoice) {
            const cleanName = frenchVoice.name.replace(/Microsoft|Google|Apple/gi, '').trim().substring(0, 16);
            voiceTag.textContent = `Voix : ${cleanName || 'Masculine'} (fr-FR)`;
          } else {
            voiceTag.textContent = 'Voix : Masculine (fr-FR)';
          }
        }
      }
    } catch (err) {
      console.warn("Erreur chargement des voix :", err);
    }
    return frenchVoice;
  }

  if ('speechSynthesis' in window) {
    loadAndSelectFrenchVoice();
    if (window.speechSynthesis.onvoiceschanged !== undefined) {
      window.speechSynthesis.onvoiceschanged = loadAndSelectFrenchVoice;
    }
  }

  // Formulation médicale et fœtale fluide commençant DIRECTEMENT par le numéro de semaine et les faits
  // Absolument aucune mention de 'Bienvenue', 'Fatou' ou 'RMA'
  function generateFrenchNarrationText(data) {
    return `Semaine ${data.week} de votre grossesse. ` +
           `Votre petit garçon mesure environ ${data.metrics}, ce qui correspond à la taille d'une ${data.fruit.toLowerCase()}. ` +
           `Développement in utero : ${data.inUtero} ` +
           `Sur le plan morphologique : ${data.morpho} ` +
           `Conseil de bien-être : ${data.advice}`;
