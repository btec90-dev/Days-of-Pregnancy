        head.scale.set(0.7, 0.7, 0.7);
        armL.visible = true;
        armR.visible = true;
        armL.scale.set(0.5, 0.5, 0.5);
        armR.scale.set(0.5, 0.5, 0.5);
        legL.visible = false;
        legR.visible = false;
      } else {
        head.scale.set(1.0, 1.0, 1.0);
        armL.visible = true;
        armR.visible = true;
        legL.visible = true;
        legR.visible = true;
        armL.scale.set(1, 1, 1);
        armR.scale.set(1, 1, 1);
      }
    };
    window.updateFetus3DScale = updateFetusAnatomyMesh;
