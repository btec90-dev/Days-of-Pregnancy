        } else {
          playPauseIcon.innerHTML = '<path d="M8 5v14l11-7z"></path>';
          videoStatusText.textContent = 'Pause (Vidéo figée)';
        }
      }
    });

    if (resetCamBtn) {
      resetCamBtn.addEventListener('click', () => {
        if (resetCameraView) resetCameraView();
      });
    }

    btnToggleDoppler.addEventListener('click', () => {
      toggleDopplerHeartbeat();
    });

    // Navigation rapide semaines
    document.getElementById('btn-prev-week').addEventListener('click', () => {
      if (currentWeek > 1) selectWeek(currentWeek - 1, toggleAutoplay.checked);
    });
    document.getElementById('btn-next-week').addEventListener('click', () => {
      if (currentWeek < 40) selectWeek(currentWeek + 1, toggleAutoplay.checked);
    });

    slider.addEventListener('input', (e) => {
      selectWeek(parseInt(e.target.value), false);
    });

    // Onglets des dossiers cliniques inférieurs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('bg-parchment-100', 'border', 'border-[#cfb286]', 'text-amber-950');
          b.classList.add('bg-amber-900/20', 'text-amber-900');
        });
        btn.classList.add('bg-parchment-100', 'border', 'border-[#cfb286]', 'text-amber-950');
        btn.classList.remove('bg-amber-900/20', 'text-amber-900');

        const targetId = btn.dataset.target;
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
        document.getElementById(targetId)?.classList.remove('hidden');
      });
    });

    // Initialisation sur la Semaine 12
    selectWeek(12, false);
  });
</script>


</body></html>