  // Synthétiseur audio Web Audio API pour battement de cœur Doppler réaliste
  function toggleDopplerHeartbeat() {
    const label = document.getElementById('doppler-sound-label');
    const curWeekData = window.PREGNANCY_WEEKS[(window.currentActiveWeek || 12) - 1];
    const bpm = (curWeekData && curWeekData.heartRate) ? curWeekData.heartRate : 158;

    if (isDopplerPlaying) {
      if (dopplerInterval) clearInterval(dopplerInterval);
      isDopplerPlaying = false;
      label.textContent = `Doppler Cardiaque (${bpm} bpm)`;
      return;
    }

    try {
      if (!dopplerAudioCtx) {
        dopplerAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (dopplerAudioCtx.state === 'suspended') {
        dopplerAudioCtx.resume();
      }

      isDopplerPlaying = true;
      label.textContent = `🔊 Battements Actifs (${bpm} bpm)`;

      const playThump = (freq, duration, gainVal) => {
        if (!dopplerAudioCtx) return;
        const osc = dopplerAudioCtx.createOscillator();
        const gain = dopplerAudioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, dopplerAudioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(32, dopplerAudioCtx.currentTime + duration);

        gain.gain.setValueAtTime(gainVal, dopplerAudioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, dopplerAudioCtx.currentTime + duration);

        osc.connect(gain);
        gain.connect(dopplerAudioCtx.destination);

        osc.start();
        osc.stop(dopplerAudioCtx.currentTime + duration);
      };

      const intervalMs = (60 / bpm) * 1000;
      dopplerInterval = setInterval(() => {
        // Double battement fœtal lub-dub caractéristique
        playThump(85, 0.12, 0.22);
        setTimeout(() => {
          playThump(65, 0.10, 0.16);
        }, 110);
      }, intervalMs);

    } catch (e) {
      console.warn("Web Audio non disponible", e);
    }
  }

