    legL.position.set(0.6, -1.3, 0.6);
    legL.rotation.x = 0.9;
    legL.rotation.z = -0.3;
    fetus.add(legL);

    const legR = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.22, 1.3, 16), limbMat);
    legR.position.set(-0.6, -1.3, 0.6);
    legR.rotation.x = 0.9;
    legR.rotation.z = 0.3;
    fetus.add(legR);

