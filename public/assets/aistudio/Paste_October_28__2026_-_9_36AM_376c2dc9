  // Prépare les boîtes de mots pour la transcription interactive
  function setupTranscriptionDisplay(fullText) {
    const box = document.getElementById('audio-live-transcription-box');
    if (!box) return;
    box.innerHTML = '';
    const words = fullText.split(/\s+/).filter(w => w.trim().length > 0);
    currentWordList = words;

    words.forEach((w, index) => {
      const span = document.createElement('span');
      span.className = 'karaoke-word';
      span.id = `kw-${index}`;
      span.textContent = w + ' ';
      box.appendChild(span);
    });
  }

  function highlightKaraokeIndex(wordIdx) {
    const total = currentWordList.length;
    for (let i = 0; i < total; i++) {
      const el = document.getElementById(`kw-${i}`);
      if (!el) continue;
      if (i < wordIdx) {
        el.className = 'karaoke-word past-word';
      } else if (i === wordIdx) {
        el.className = 'karaoke-word active-word';
        // Auto-scroll pour garder le mot visible
        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        el.className = 'karaoke-word';
      }
    }
  }

  function resetKaraokeHighlight() {
    if (karaokeInterval) {
      clearInterval(karaokeInterval);
      karaokeInterval = null;
    }
    document.querySelectorAll('.karaoke-word').forEach(el => {
      el.className = 'karaoke-word';
    });
  }

  function setAudioPlayingUI(playing) {
    const waveContainer = document.getElementById('audio-wave-container');
    const idleBadge = document.getElementById('audio-idle-badge');
    const iconBtn = document.getElementById('icon-voice-action');
    const textBtn = document.getElementById('text-voice-action');

    if (playing) {
      isSpeaking = true;
      if (waveContainer) {
        waveContainer.classList.remove('hidden');
        waveContainer.classList.add('flex');
      }
      if (idleBadge) idleBadge.classList.add('hidden');
      if (iconBtn) iconBtn.textContent = 'pause';
      if (textBtn) textBtn.textContent = 'Mettre en pause';
    } else {
      isSpeaking = false;
      if (waveContainer) {
        waveContainer.classList.add('hidden');
        waveContainer.classList.remove('flex');
      }
      if (idleBadge) idleBadge.classList.remove('hidden');
      if (iconBtn) iconBtn.textContent = 'play_arrow';
      if (textBtn) textBtn.textContent = 'Écouter la narration masculine (Français)';
      resetKaraokeHighlight();
    }
  }

  // Son de carillon doux via Web Audio pour feedback instantané lors du clic
  function playGentleNarratorChime() {
    try {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return;
      const ctx = new AudioCtx();
      if (ctx.state === 'suspended') ctx.resume();

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(554.37, ctx.currentTime + 0.12);

      gain.gain.setValueAtTime(0.06, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.28);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.3);
    } catch (e) {
      // Ignorer si bloqué
    }
  }

  // Lecture de la transcription d'une semaine donnée
  function playNarrationForWeek(weekNum) {
    const data = window.PREGNANCY_WEEKS[weekNum - 1];
    if (!data) return;

    // Déblocage audio immédiat
    playGentleNarratorChime();

    const fullText = generateFrenchNarrationText(data);
    setupTranscriptionDisplay(fullText);

    // Si speechSynthesis est disponible
    if ('speechSynthesis' in window) {
      try {
        // Déblocage & nettoyage préventif du moteur SpeechSynthesis
        window.speechSynthesis.cancel();
        if (window.speechSynthesis.paused) {
          window.speechSynthesis.resume();
        }

        const chosenVoice = loadAndSelectFrenchVoice();

        const utterance = new SpeechSynthesisUtterance(fullText);
        utterance.lang = 'fr-FR';
        // Paramètres optimisés : débit calme et posé (0.83), voix masculine chaleureuse (pitch 0.92)
        utterance.rate = 0.83;
        utterance.pitch = 0.92;
        if (chosenVoice) {
          utterance.voice = chosenVoice;
        }

        let wordCounter = 0;
        const totalWords = currentWordList.length;

        // Événement boundary pour surlignage précis mot par mot
        utterance.onboundary = (event) => {
          if (event.name === 'word') {
            highlightKaraokeIndex(wordCounter);
            wordCounter = Math.min(totalWords - 1, wordCounter + 1);
          }
        };

        utterance.onstart = () => {
          setAudioPlayingUI(true);
          // Si l'événement boundary ne s'active pas dans certains navigateurs, timer de secours synchronisé
          if (!karaokeInterval) {
            let step = 0;
            const msPerWord = 390; // Calibré pour un débit posé (rate: 0.83)
            karaokeInterval = setInterval(() => {
              if (step < totalWords) {
                highlightKaraokeIndex(step);
                step++;
              } else {
                clearInterval(karaokeInterval);
              }
            }, msPerWord);
          }
        };

        utterance.onend = () => {
          setAudioPlayingUI(false);
          document.querySelectorAll('.karaoke-word').forEach(el => {
            el.className = 'karaoke-word past-word';
          });
        };

        utterance.onerror = (e) => {
          console.warn("Événement SpeechSynthesis error, bascule fallback :", e);
          fallbackKaraokePlay(fullText);
        };

        window.speechSynthesis.speak(utterance);
        return;
      } catch (err) {
        console.warn("Erreur SpeechSynthesis, bascule fallback visuelle :", err);
      }
    }

    // Fallback si SpeechSynthesis non disponible ou bloqué
    fallbackKaraokePlay(fullText);
  }

  function fallbackKaraokePlay(fullText) {
    setAudioPlayingUI(true);
    let step = 0;
    const words = currentWordList;
    if (karaokeInterval) clearInterval(karaokeInterval);

    karaokeInterval = setInterval(() => {
      if (step < words.length) {
        highlightKaraokeIndex(step);
        step++;
      } else {
        clearInterval(karaokeInterval);
        setAudioPlayingUI(false);
      }
    }, 390);
  }

  function stopNarration() {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    setAudioPlayingUI(false);
  }

