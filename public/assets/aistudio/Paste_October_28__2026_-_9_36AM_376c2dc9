      u.lang = 'fr-FR';
      u.rate = 0.83;
      u.pitch = 0.92;
      if (chosenVoice) u.voice = chosenVoice;

      u.onstart = () => setAudioPlayingUI(true);
      u.onend = () => setAudioPlayingUI(false);
      u.onerror = () => setAudioPlayingUI(false);

      let step = 0;
      karaokeInterval = setInterval(() => {
        if (step < currentWordList.length) {
          highlightKaraokeIndex(step);
          step++;
        } else {
          clearInterval(karaokeInterval);
        }
      }, 390);

      window.speechSynthesis.speak(u);
    } else {
      fallbackKaraokePlay(textToRead);
    }
